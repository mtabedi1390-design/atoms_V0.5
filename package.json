{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:native": "bash scripts/test_native.sh",
    "test:browser": "playwright test",
    "bench": "node scripts/benchmark.mjs",
    "data:build": "python3 science/build_atomic_data.py",
    "data:matrix": "tsx scripts/generate_accuracy_matrix.ts",
    "data:hf": "python3 science/hf_export.py",
    "release:pack": "node scripts/package_release.mjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^5.0.6",
    "clsx": "2.1.1",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^2.1.8"
  }
}
